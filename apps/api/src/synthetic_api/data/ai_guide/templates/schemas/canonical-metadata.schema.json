    "canonicalItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "bindingPath",
        "label",
        "property",
        "namespace",
        "value",
        "valueType",
        "sourceType",
        "status",
        "confidence",
        "reason",
        "updatedAt",
        "sourceReference"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "bindingPath": {
          "type": "string",
          "pattern": "^/"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "property": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "valueType": {
          "enum": [
            "string",
            "number",
            "integer",
            "boolean",
            "object",
            "array",
            "null"
