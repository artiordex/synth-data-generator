            "type": "string"
          }
        },
        "temporal_alignment": {
          "$ref": "#/$defs/nullableString"
        },
        "spatial_alignment": {
          "$ref": "#/$defs/nullableString"
        },
        "source_dataset_ids": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "external_sources": {
          "type": [
            "array",
            "null"
          ],
          "items": {}
        },
        "output_description": {
          "$ref": "#/$defs/nullableString"
