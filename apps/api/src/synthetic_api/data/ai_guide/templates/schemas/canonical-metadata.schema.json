        "name": {
          "$ref": "#/$defs/nullableString"
        },
        "input": {
          "$ref": "#/$defs/nullableString"
        },
        "rules": {
          "$ref": "#/$defs/nullableString"
        },
        "parameters": {
          "$ref": "#/$defs/nullableString"
        },
        "output": {
          "$ref": "#/$defs/nullableString"
