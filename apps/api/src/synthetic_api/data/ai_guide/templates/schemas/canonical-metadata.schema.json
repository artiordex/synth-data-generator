    "templateVersion",
    "document",
    "dataset",
    "modality_specifications",
    "responsible_ai",
    "structure",
    "processing",
    "fields",
    "pipeline",
    "statistics",
    "quality",
    "ai",
    "interoperability",
    "usage",
    "lineage",
    "governance",
    "artifacts",
    "fair",
    "reviewRequired",
    "provenance",
    "analysis",
    "canonicalItems",
    "references"
