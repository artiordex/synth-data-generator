            "name": {
              "$ref": "#/$defs/nullableString"
            },
            "email": {
              "$ref": "#/$defs/nullableString"
            },
            "phone": {
              "$ref": "#/$defs/nullableString"
            }
          }
        },
        "language": {
          "$ref": "#/$defs/nullableString"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "$ref": "#/$defs/nullableString"
        },
        "temporal": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "$ref": "#/$defs/nullableString"
            },
            "end": {
              "$ref": "#/$defs/nullableString"
            }
          }
        },
        "spatial": {
          "$ref": "#/$defs/nullableString"
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "version_info": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "version",
            "issued",
            "modified",
            "version_notes"
          ],
          "properties": {
            "version": {
              "$ref": "#/$defs/nullableString"
            },
            "issued": {
              "$ref": "#/$defs/nullableString"
            },
            "modified": {
              "$ref": "#/$defs/nullableString"
            },
            "version_notes": {
              "$ref": "#/$defs/nullableString"
            }
          }
        },
        "uri_or_id": {
          "type": "string",
          "minLength": 1
        },
        "theme_label": {
          "$ref": "#/$defs/nullableString"
        }
      }
