        "data_type": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "is_pk": {
          "$ref": "#/$defs/nullableBoolean"
        },
        "statistics": {
          "type": "object",
          "additionalProperties": true
        },
        "sample_values": {
          "type": "array"
        },
        "path_syntax": {
          "$ref": "#/$defs/nullableString"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "source_category": {
          "enum": [
            "file",
            "api"
          ]
        },
        "value_origin": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "observed",
            "derived",
            "calculated",
            "imputed",
            "estimated",
            "modeled",
            null
          ]
        },
        "source_dataset_id": {
          "$ref": "#/$defs/nullableString"
        },
        "source_field": {
          "$ref": "#/$defs/nullableString"
