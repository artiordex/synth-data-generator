          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/itemStatus"
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "updatedAt": {
          "type": "string",
          "minLength": 1
        },
        "sourceReference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reviewItem": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "category",
        "label",
        "reason",
        "action",
        "status",
        "bindingPath",
        "sourceType",
        "confidence",
        "updatedAt"
      ],
