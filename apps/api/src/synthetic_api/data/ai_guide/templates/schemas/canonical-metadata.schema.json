        "path": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "name_ko": {
          "$ref": "#/$defs/nullableString"
        },
        "order": {
          "type": "integer",
          "minimum": 1
