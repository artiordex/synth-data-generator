      "properties": {
        "identifier": {
          "$ref": "#/$defs/nullableString"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "$ref": "#/$defs/nullableString"
        },
        "purpose": {
          "$ref": "#/$defs/nullableString"
        },
        "legal_references": {
          "$ref": "#/$defs/nullableString"
        },
        "publisher": {
          "$ref": "#/$defs/nullableString"
        },
        "creator": {
          "$ref": "#/$defs/nullableString"
        },
        "landing_page": {
          "$ref": "#/$defs/nullableString"
        },
        "access_url": {
          "$ref": "#/$defs/nullableString"
        },
        "update_frequency": {
          "$ref": "#/$defs/nullableString"
        },
        "theme": {
          "$ref": "#/$defs/nullableString"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
