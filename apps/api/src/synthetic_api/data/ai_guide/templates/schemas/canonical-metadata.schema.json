        "reason": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "REVIEW_REQUIRED"
        },
        "bindingPath": {
          "type": "string",
          "pattern": "^/"
        },
        "sourceType": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "updatedAt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "generator_name",
        "generator_version",
        "source_file_sha256",
        "generated_utc"
