        "usage_risks": {
          "type": [
            "array",
            "null"
          ],
          "items": {}
        }
      }
    },
    "interoperability": {
      "type": "object",
      "additionalProperties": true
    },
    "usage": {
      "type": "object",
      "additionalProperties": true
    },
    "lineage": {
      "type": "object",
      "additionalProperties": true
    },
    "governance": {
      "type": "object",
      "additionalProperties": true
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": true
    },
    "fair": {
      "type": "object",
      "additionalProperties": true
    },
    "reviewRequired": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reviewItem"
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "analysis": {
      "$ref": "#/$defs/analysis"
    },
    "canonicalItems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/canonicalItem"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "processing": {
      "$ref": "#/$defs/processing"
    }
