      "additionalProperties": true,
      "required": [
        "field_id",
        "path",
        "name",
        "name_ko",
        "order",
        "data_type",
        "required",
        "is_pk",
        "statistics",
        "sample_values",
        "path_syntax",
        "source",
        "source_category"
      ],
      "properties": {
        "field_id": {
          "type": "string",
          "minLength": 1
