    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "nullableInteger": {
      "type": [
        "integer",
        "null"
      ]
    },
    "nullableNumber": {
      "type": [
        "number",
        "null"
      ]
    },
    "nullableBoolean": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "document": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status",
        "generated_utc",
        "doc_type",
        "specification_version",
        "review_status",
        "is_draft",
        "review_notice"
      ],
