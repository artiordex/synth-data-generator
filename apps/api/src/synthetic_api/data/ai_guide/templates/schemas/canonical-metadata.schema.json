        "has_file_data": {
          "type": "boolean"
        },
        "has_api_data": {
          "type": "boolean"
        },
        "root_type": {
          "type": "string"
        },
        "is_large_dataset": {
          "type": "boolean"
        },
        "distribution": {
          "type": "object",
          "additionalProperties": true
        },
        "api_specification": {
          "type": "object",
          "additionalProperties": true
        },
        "traits": {
