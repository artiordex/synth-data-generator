        "is_draft": {
          "type": "boolean"
        },
        "review_notice": {
          "type": "string"
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "identifier",
        "title",
        "description",
        "purpose",
        "legal_references",
        "publisher",
        "creator",
        "landing_page",
        "access_url",
        "update_frequency",
        "theme",
        "keywords",
        "contact_point",
        "language",
        "byte_size",
        "media_type",
        "temporal",
        "spatial",
        "relations",
        "version_info",
        "uri_or_id",
        "theme_label"
