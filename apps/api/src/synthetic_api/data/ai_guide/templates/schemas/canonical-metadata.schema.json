      "properties": {
        "generator_name": {
          "type": "string",
          "minLength": 1
        },
        "generator_version": {
          "type": "string",
          "minLength": 1
        },
        "source_file_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "generated_utc": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "analysis": {
      "type": "object",
