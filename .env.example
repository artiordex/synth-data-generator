# SYNTH DATA STUDIO - Environment Configuration
APP_ENV=development
DEBUG=True
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000

# Storage Paths
STORAGE_DIR=storage
UPLOADS_DIR=storage/uploads
OUTPUTS_DIR=storage/outputs
TEMP_DIR=storage/temp
DATABASE_URL=sqlite:///storage/local/app.db

# Differential Privacy Defaults
DP_DEFAULT_EPSILON=1.0
DP_DEFAULT_DELTA=0.00001

# Worker & Model Defaults
DEFAULT_MODEL=ctgan
DEFAULT_EPOCHS=30
DEFAULT_BATCH_SIZE=64
MAX_FILE_SIZE_MB=100

# Project-scoped consistent pseudonym tokens (change for each installation)
PSEUDONYM_TOKEN_SECRET=replace-with-an-internal-random-secret

# Optional OpenAI-assisted column description polishing
# Keep disabled for fully local/rule-based generation.
OPENAI_API_KEY=
OPENAI_COLUMN_DESCRIPTION_ENABLED=false
OPENAI_COLUMN_DESCRIPTION_MODEL=
OPENAI_COLUMN_DESCRIPTION_SYSTEM_PROMPT=너는 한국 공공기관 심의자료의 원본데이터 명세서 문장을 작성한다. 컬럼명, 정보영역, 기본 설명, 일부 고유값 예시를 보고 항목 설명 한 문장만 작성한다. 준식별자는 '개인의 ~' 형태를 우선 사용하고, 일반정보는 '~ 응답정보' 또는 '~ 정보' 형태를 사용한다. 개인정보나 원본값을 추정하지 말고, 50자 이내의 명사형 한국어 문장만 반환한다.
OPENAI_COLUMN_DESCRIPTION_ONLY_AMBIGUOUS=true
OPENAI_COLUMN_DESCRIPTION_MAX_OUTPUT_TOKENS=40
OPENAI_COLUMN_DESCRIPTION_TIMEOUT_SEC=8
OPENAI_COLUMN_DESCRIPTION_CACHE_TTL_DAYS=30
OPENAI_COLUMN_DESCRIPTION_CACHE_PATH=storage/local/column_description_cache.json
