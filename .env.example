# SYNTH DATA STUDIO - Environment Configuration
APP_ENV=development
DEBUG=True
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000

# Storage Paths
STORAGE_DIR=storage
UPLOADS_DIR=storage/uploads
OUTPUTS_DIR=storage/outputs
TEMP_DIR=storage/temp
DATABASE_URL=sqlite:///storage/local/app.db

# Differential Privacy Defaults
DP_DEFAULT_EPSILON=1.0
DP_DEFAULT_DELTA=0.00001

# Worker & Model Defaults
DEFAULT_MODEL=ctgan
DEFAULT_EPOCHS=30
DEFAULT_BATCH_SIZE=64
MAX_UPLOAD_SIZE_MB=50
