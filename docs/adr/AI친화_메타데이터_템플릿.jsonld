          "ai:note": "{{fair.interoperable_note}}"
        },
        "ai:reusable": {
          "ai:score": "{{fair.reusable_score}}",
          "ai:note": "{{fair.reusable_note}}"
        }
      },
      "ai:reviewRequired": [
        "{{#reviewRequired}}",
        {
          "rdfs:comment": "canonicalItems에서 REVIEW_REQUIRED인 항목만 추출한 기관 확인 목록. AUTO_INFERRED는 canonicalItems에 별도 유지.",
          "ai:id": "{{item.id}}",
          "ai:category": "{{item.category}}",
          "ai:label": "{{item.label}}",
          "ai:reason": "{{item.reason}}",
          "ai:action": "{{item.action}}",
          "ai:status": "{{item.status}}",
          "ai:bindingPath": "{{item.bindingPath}}",
          "ai:sourceType": "{{item.sourceType}}",
          "ai:confidence": "{{item.confidence}}",
          "ai:updatedAt": "{{item.updatedAt}}"
        },
        "{{/reviewRequired}}"
      ],
      "ai:provenance": {
        "rdfs:comment": "산출물 생성 엔진 및 파일 무결성 해시 정보 (prov:Activity)",
        "ai:generator_name": "SynthData Studio AI-Ready Engine",
        "ai:generator_version": "{{provenance.generator_version}}",
        "ai:source_file_sha256": "{{provenance.source_file_sha256}}",
        "ai:generated_utc": "{{provenance.generated_utc}}"
      },
      "ai:analysis": {
        "rdfs:comment": "ADR-002/003/004 분석 범위. 샘플 통계를 전체 품질로 주장하지 않는다.",
        "ai:scope": "{{analysis.scope}}",
        "ai:sample_size": "{{analysis.sample_size}}",
        "ai:population_size": "{{analysis.population_size}}",
        "ai:sampling_method": "{{analysis.sampling_method}}",
        "ai:record_boundary_preserved": "{{analysis.record_boundary_preserved}}",
        "ai:limitations": "{{analysis.limitations}}",
        "ai:analyzed_at": "{{analysis.analyzed_at}}"
      },
      "ai:canonicalItems": [
        "{{#canonicalItems}}",
        {
          "rdfs:comment": "ADR-003 v2의 완전한 항목 레코드. 데이터 사전·모달리티·법령·API 계약 등 모든 동적 값과 bindingPath로 일대일 연결. 레코드 자체의 provenance 필드는 재귀 검토하지 않는다.",
          "ai:id": "{{entry.id}}",
          "ai:bindingPath": "{{entry.bindingPath}}",
          "ai:label": "{{entry.label}}",
          "ai:property": "{{entry.property}}",
          "ai:namespace": "{{entry.namespace}}",
          "ai:value": {
            "@value": "{{entry.value}}",
            "@type": "@json"
          },
          "ai:valueType": "{{entry.valueType}}",
          "ai:sourceType": "{{entry.sourceType}}",
          "ai:status": "{{entry.status}}",
          "ai:confidence": "{{entry.confidence}}",
          "ai:reason": "{{entry.reason}}",
          "ai:updatedAt": "{{entry.updatedAt}}",
          "ai:sourceReference": "{{entry.sourceReference}}"
        },
        "{{/canonicalItems}}"
      ],
      "ai:references": [
        "{{#references}}",
        {
          "rdfs:comment": "ADR-001 기준자료 추적. PRIMARY/SUPPLEMENTARY 구분; 특정 기관 사례는 범용 기준으로 등록하지 않는다.",
          "ai:id": "{{reference.id}}",
          "ai:title": "{{reference.title}}",
          "ai:version": "{{reference.version}}",
          "ai:source": "{{reference.source}}",
          "ai:locator": "{{reference.locator}}",
          "ai:role": "{{reference.role}}",
          "ai:verification_status": "{{reference.verification_status}}"
        },
        "{{/references}}"
      ],
      "ai:profilePolicy": {
        "rdfs:comment": "파일/API 통합 템플릿. structure.data_category=file ↔ document.doc_type=file_dataset; api ↔ api_dataset. 모달리티 적용 여부는 제공 유형과 독립이다.",
        "ai:applicability": "두 구조 블록을 공통 정의로 유지한다. 실제 적용 범위를 원천 명세로 판단하고 비해당 스칼라는 null/NOT_APPLICABLE, 비해당 반복 목록은 []로 표현한다. API가 파일 배포도 제공하면 distribution을 함께 작성할 수 있다. API 계약 미확정을 비해당으로 처리하지 않는다.",
        "ai:reviewSummaryPolicy": "reviewRequired는 canonicalItems 중 status=REVIEW_REQUIRED인 항목의 파생 목록이며 id/bindingPath/status/sourceType/confidence/reason/updatedAt는 원본과 일치해야 한다. 하나라도 남으면 document.review_status=INCOMPLETE_REVIEW, document.is_draft=true, document.review_notice='임시 검토본 - 기관 공식 확인 필요'. REVIEW_REQUIRED 없이 AUTO_INFERRED만 남으면 INFERRED_DRAFT/is_draft=true 및 AI 작성 초안 안내. 모두 AUTO_CONFIRMED/USER_CONFIRMED/NOT_APPLICABLE이면 COMPLETE_REVIEW/is_draft=false 및 빈 review_notice. 검토 레코드 누락·중복·값 불일치는 내보내기 오류."
      }
    }
  ]
}
