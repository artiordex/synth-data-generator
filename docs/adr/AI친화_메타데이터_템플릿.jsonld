{
  "@context": {
    "adms": "http://www.w3.org/ns/adms#",
    "dcat": "http://www.w3.org/ns/dcat#",
    "dct": "http://purl.org/dc/terms/",
    "foaf": "http://xmlns.com/foaf/0.1/",
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "owl": "http://www.w3.org/2002/07/owl#",
    "prov": "http://www.w3.org/ns/prov#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "spdx": "http://spdx.org/rdf/terms#",
    "vcard": "http://www.w3.org/2006/vcard/ns#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "schema": "http://schema.org/",
    "exif": "http://www.w3.org/2003/12/exif/ns#",
    "rai": "http://mlcommons.org/croissant/RAI/",
    "cr": "http://mlcommons.org/croissant/",
    "dqv": "http://www.w3.org/ns/dqv#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "api": "urn:synthetic-data:openapi:v1:",
    "title": "dct:title",
    "description": "dct:description",
    "identifier": "dct:identifier",
    "references": "dct:references",
    "publisher": {
      "@id": "dct:publisher",
      "@type": "@id"
    },
    "creator": "dct:creator",
    "issued": {
      "@id": "dct:issued",
      "@type": "xsd:date"
    },
    "modified": {
      "@id": "dct:modified",
      "@type": "xsd:date"
    },
    "language": "dct:language",
    "license": {
      "@id": "dct:license",
      "@type": "@id"
    },
    "rights": "dct:rights",
    "accrualPeriodicity": "dct:accrualPeriodicity",
    "spatial": "dct:spatial",
    "temporal": "dct:temporal",
    "theme": {
      "@id": "dcat:theme",
      "@type": "@id"
    },
    "keyword": "dcat:keyword",
    "contactPoint": "dcat:contactPoint",
    "landingPage": {
      "@id": "dcat:landingPage",
      "@type": "@id"
    },
    "distribution": {
      "@id": "dcat:distribution",
      "@type": "@id"
    },
    "byteSize": {
      "@id": "dcat:byteSize",
      "@type": "xsd:nonNegativeInteger"
    },
    "mediaType": "dcat:mediaType",
    "accessURL": {
      "@id": "dcat:accessURL",
      "@type": "@id"
    },
    "versionInfo": "owl:versionInfo",
    "versionNotes": "adms:versionNotes",
    "wasGeneratedBy": {
      "@id": "prov:wasGeneratedBy",
      "@type": "@id"
    },
    "@version": 1.1,
    "ai": "urn:synthetic-data:ai-ready:v2:",
    "hasQualityMeasurement": {
      "@id": "dqv:hasQualityMeasurement",
      "@type": "@id"
    }
  },
  "@graph": [
    {
      "@id": "{{dataset.uri_or_id}}",
      "ai:schemaVersion": "2.0",
      "ai:templateVersion": "2.3",
      "ai:reviewPolicy": {
        "rdfs:comment": "항목별 5-state 검토 상태. 신뢰도는 승인 상태를 대체하지 않는다. 미확정은 null, 비해당은 null/NOT_APPLICABLE과 사유를 보존한다.",
        "ai:statusCodes": [
          "AUTO_CONFIRMED",
          "AUTO_INFERRED",
          "USER_CONFIRMED",
          "REVIEW_REQUIRED",
          "NOT_APPLICABLE"
        ],
        "ai:requiredReviewPolicy": "법령·라이선스·개인정보·담당자·API 계약은 기관 승인 전 REVIEW_REQUIRED. 잔여 시 document.review_status=INCOMPLETE_REVIEW 및 임시 검토본 표시."
      },
      "@type": [
        "dcat:Dataset",
        "schema:Dataset"
      ],
      "rdfs:comment": "REF-01 표 7~16 및 ADR-001~005를 참조한 JSON-LD 1.1 템플릿. ai:/api:는 프로젝트 확장이다. 국가 프로파일/Croissant 완전 적합성 인증을 주장하지 않는다. 모든 값은 ai:canonicalItems의 ai:bindingPath와 연결한다. 반복·타입·검토본 계약은 AI친화_메타데이터_템플릿.json의 _template 참조.",
      "title": "{{dataset.title}}",
      "description": "{{dataset.description}}",
      "identifier": "{{dataset.identifier}}",
      "references": "{{dataset.legal_references}}",
      "publisher": {
        "@type": "foaf:Organization",
        "foaf:name": "{{dataset.publisher}}",
        "schema:department": {
          "@type": "schema:Organization",
          "schema:name": "{{dataset.creator}}"
        }
      },
      "creator": "{{dataset.creator}}",
      "theme": "{{dataset.theme}}",
      "keyword": [
        "{{#dataset.keywords}}",
        "{{keyword}}",
        "{{/dataset.keywords}}"
      ],
      "contactPoint": {
        "@type": "vcard:Individual",
        "vcard:fn": "{{dataset.contact.name}}",
        "vcard:hasEmail": "{{dataset.contact.email}}",
        "vcard:hasTelephone": "{{dataset.contact.phone}}"
      },
      "license": "{{usage.license}}",
      "rights": "{{usage.rights}}",
      "accrualPeriodicity": "{{dataset.update_frequency}}",
      "temporal": {
        "@type": "dct:PeriodOfTime",
        "schema:startDate": "{{dataset.temporal.start}}",
        "schema:endDate": "{{dataset.temporal.end}}"
      },
      "spatial": "{{dataset.spatial}}",
      "landingPage": "{{dataset.landing_page}}",
      "versionInfo": "{{dataset.version.current}}",
      "issued": "{{dataset.version.issued}}",
      "modified": "{{dataset.version.modified}}",
      "versionNotes": "{{dataset.version.notes}}",
      "distribution": [
        {
          "@id": "{{dataset.uri_or_id}}#distribution",
          "@type": "dcat:Distribution",
          "title": "{{dataset.title}} 원천 배포",
          "accessURL": "{{dataset.access_url}}",
          "mediaType": "{{dataset.media_type}}",
          "byteSize": "{{dataset.byte_size}}"
        }
      ],
      "rai:dataBiases": "{{responsible_ai.data_biases}}",
      "rai:knownLimitations": "{{responsible_ai.known_limitations}}",
      "rai:dataCollectionMissingData": "{{responsible_ai.missing_data_info}}",
      "schema:image": {
        "@type": "schema:ImageObject",
        "schema:width": "{{modality.image.width}}",
        "schema:height": "{{modality.image.height}}",
        "exif:make": "{{modality.image.exif_make}}",
        "exif:model": "{{modality.image.exif_model}}",
        "schema:encodingFormat": "{{modality.image.media_type}}",
        "ai:is_applicable": "{{modality.image.is_applicable}}",
        "ai:resource_id": "{{modality.image.resource_id}}",
        "schema:additionalProperty": [
          {
            "@type": "schema:PropertyValue",
            "schema:name": "color_space",
            "schema:value": "{{modality.image.color_space}}",
            "schema:description": "색 공간 (RGB, Grayscale, CMYK)"
          },
          {
            "@type": "schema:PropertyValue",
            "schema:name": "resolution_dpi",
            "schema:value": "{{modality.image.dpi}}",
            "schema:description": "해상도 DPI (예: 300)"
          },
          {
            "@type": "schema:PropertyValue",
            "schema:name": "bit_depth",
            "schema:value": "{{modality.image.bit_depth}}",
            "schema:description": "채널당 비트 수(bit), 정수."
          },
          {
            "@type": "schema:PropertyValue",
            "schema:name": "capture_datetime",
            "schema:value": "{{modality.image.capture_datetime}}",
            "schema:description": "촬영 시각(ISO 8601, 시간대 포함). EXIF에 시간대가 없으면 임의 보완 금지."
          },
          {
            "@type": "schema:PropertyValue",
            "schema:name": "capture_environment",
            "schema:value": "{{modality.image.capture_environment}}",
            "schema:description": "촬영 환경·조명·장비 배치 설명. 선택적 프로젝트 확장; 관측/기관 확인 근거 기록."
          }
        ],
        "rdfs:comment": "REF-01 표 14~16에 명시된 기본 속성 및 조건부 프로젝트 확장. 해당 없음은 ai:is_applicable=false와 NOT_APPLICABLE 레코드로 표현."
      },
      "schema:video": {
        "@type": "schema:VideoObject",
        "schema:width": "{{modality.video.width}}",
        "schema:height": "{{modality.video.height}}",
        "schema:duration": "{{modality.video.duration}}",
        "schema:frameRate": "{{modality.video.frame_rate}}",
        "schema:encodingFormat": "{{modality.video.media_type}}",
        "ai:is_applicable": "{{modality.video.is_applicable}}",
        "ai:resource_id": "{{modality.video.resource_id}}",
        "schema:additionalProperty": [
          {
            "@type": "schema:PropertyValue",
            "schema:name": "codec",
            "schema:value": "{{modality.video.codec}}",
            "schema:description": "비디오 코덱명 (schema:additionalProperty codec, 선택, 예: MPEG-4 Part 2, H.264, HEVC)"
          },
          {
            "@type": "schema:PropertyValue",
            "schema:name": "bitrate",
            "schema:value": "{{modality.video.bitrate}}",
            "schema:description": "초당 비트 수(bps), 숫자. kbps 등 표시 문자열을 혼용하지 않는다."
          },
          {
            "@type": "schema:PropertyValue",
            "schema:name": "frame_count",
            "schema:value": "{{modality.video.frame_count}}",
            "schema:description": "총 프레임 수, 정수. 길이×FPS 추정값과 직접 측정값의 상태를 구분."
          },
          {
            "@type": "schema:PropertyValue",
            "schema:name": "capture_start",
            "schema:value": "{{modality.video.capture_start}}",
            "schema:description": "촬영 시작 시각(ISO 8601, 시간대 포함)."
          },
          {
            "@type": "schema:PropertyValue",
            "schema:name": "capture_end",
            "schema:value": "{{modality.video.capture_end}}",
            "schema:description": "촬영 종료 시각(ISO 8601, 시간대 포함)."
          },
          {
            "@type": "schema:PropertyValue",
            "schema:name": "camera_id",
            "schema:value": "{{modality.video.camera_id}}",
            "schema:description": "카메라의 비식별 리소스 ID. 특정 기관 CCTV 필드명을 강제하지 않는다."
          },
          {
            "@type": "schema:PropertyValue",
            "schema:name": "capture_environment",
            "schema:value": "{{modality.video.capture_environment}}",
            "schema:description": "설치 위치 범주·시점·조명·날씨 등 관측 환경. 공개 범위 기관 확인."
          },
          {
            "@type": "schema:PropertyValue",
            "schema:name": "time_base",
            "schema:value": "{{modality.video.time_base}}",
            "schema:description": "프레임 타임스탬프 단위/시간 기준. 가변 FPS에서는 프레임별 시각을 사용."
          }
        ],
        "rdfs:comment": "REF-01 표 14~16에 명시된 기본 속성 및 조건부 프로젝트 확장. 해당 없음은 ai:is_applicable=false와 NOT_APPLICABLE 레코드로 표현."
      },
      "schema:audio": {
        "@type": "schema:AudioObject",
        "schema:duration": "{{modality.audio.duration}}",
        "schema:encodingFormat": "{{modality.audio.media_type}}",
        "ai:is_applicable": "{{modality.audio.is_applicable}}",
        "ai:resource_id": "{{modality.audio.resource_id}}",
        "schema:additionalProperty": [
          {
            "@type": "schema:PropertyValue",
            "schema:name": "sampleRate",
            "schema:value": "{{modality.audio.sample_rate}}",
            "schema:description": "샘플레이트 (schema:additionalProperty sampleRate, 권장, 초당 샘플링 디지털 신호 Hz, 예: 16000, 44100)"
          },
          {
            "@type": "schema:PropertyValue",
            "schema:name": "channels",
            "schema:value": "{{modality.audio.channels}}",
            "schema:description": "채널 수 (schema:additionalProperty channels, 선택, 1: mono, 2: stereo)"
          },
          {
            "@type": "schema:PropertyValue",
            "schema:name": "bit_depth",
            "schema:value": "{{modality.audio.bit_depth}}",
            "schema:description": "샘플당 비트 수(bit), 정수. 적용되지 않는 압축 형식은 NOT_APPLICABLE."
          },
          {
            "@type": "schema:PropertyValue",
            "schema:name": "codec",
            "schema:value": "{{modality.audio.codec}}",
            "schema:description": "오디오 부호화 코덱(PCM, FLAC, MP3, AAC 등). WAV 같은 컨테이너/MIME은 media_type으로 구분."
          },
          {
            "@type": "schema:PropertyValue",
            "schema:name": "language",
            "schema:value": "{{modality.audio.language}}",
            "schema:description": "발화 언어 코드. 무발화 음향 데이터는 NOT_APPLICABLE."
          },
          {
            "@type": "schema:PropertyValue",
            "schema:name": "transcript_uri",
            "schema:value": "{{modality.audio.transcript_uri}}",
            "schema:description": "전사 파일/리소스 IRI. 전사 미제공과 해당 없음을 구분."
          },
          {
            "@type": "schema:PropertyValue",
            "schema:name": "speaker_count",
            "schema:value": "{{modality.audio.speaker_count}}",
            "schema:description": "비식별 화자 수, 정수. 음성에서 추론 시 AUTO_INFERRED."
          },
          {
            "@type": "schema:PropertyValue",
            "schema:name": "recording_environment",
            "schema:value": "{{modality.audio.recording_environment}}",
            "schema:description": "녹음 장비·장소 범주·잡음 등 수집 환경 설명."
          },
          {
            "@type": "schema:PropertyValue",
            "schema:name": "segment_time_unit",
            "schema:value": "{{modality.audio.segment_time_unit}}",
            "schema:description": "전사/발화 구간의 시간 단위(예: s)."
          },
          {
            "@type": "schema:PropertyValue",
            "schema:name": "snr_db",
            "schema:value": "{{modality.audio.snr_db}}",
            "schema:description": "측정된 신호 대 잡음비(dB), 숫자. 산출 방법·범위는 canonicalItems.reason에 기록."
          }
        ],
        "rdfs:comment": "REF-01 표 14~16에 명시된 기본 속성 및 조건부 프로젝트 확장. 해당 없음은 ai:is_applicable=false와 NOT_APPLICABLE 레코드로 표현."
      },
      "cr:recordSet": {
        "@id": "{{modality.tabular.record_set_id}}",
        "@type": "cr:RecordSet",
        "cr:field": [
          "{{#fields}}",
          {
            "@id": "{{field.id}}",
            "@type": "cr:Field",
            "schema:name": "{{field.name}}",
            "schema:description": "{{field.description}}",
            "cr:dataType": {
              "@id": "{{field.dataType}}"
            }
          },
          "{{/fields}}"
        ],
        "ai:is_applicable": "{{modality.tabular.is_applicable}}",
        "ai:field_pattern": "{{modality.tabular.field_pattern}}"
      },
      "api:specification": {
        "@type": "api:ServiceSpecification",
        "rdfs:comment": "Track 2 API 계약. ADR-002/003 및 REF-01 데이터 카드 접근 사양 기준. 특정 기관 양식은 범용 근거로 사용하지 않는다.",
        "api:base_url": "{{structure.api_base_url}}",
        "api:auth_type": "{{structure.api_auth_type}}",
        "api:contract_status": "{{structure.api_contract_status}}",
        "api:operations": [
          "{{#structure.api_operations}}",
          {
            "rdfs:comment": "개별 상세 기능(오퍼레이션) 명세",
            "api:operation_id": "{{operation.id}}",
            "api:operation_name": "{{operation.name}}",
            "api:description": "{{operation.description}}",
            "api:endpoint_path": "{{operation.endpoint_path}}",
            "api:http_method": "{{operation.http_method}}",
            "api:data_formats": [
              "{{#operation.formats}}",
              "{{format}}",
              "{{/operation.formats}}"
            ],
            "api:request_parameters": [
              "{{#operation.request_parameters}}",
              {
                "rdfs:comment": "요청(Request) 파라미터 규격",
                "api:param_name": "{{param.name}}",
                "api:name_ko": "{{param.name_ko}}",
                "api:location": "{{param.location}}",
                "api:data_type": "{{param.data_type}}",
                "api:required": "{{param.required}}",
                "api:sample_value": "{{param.sample_value}}",
                "api:description": "{{param.description}}"
              },
              "{{/operation.request_parameters}}"
            ],
            "api:response_parameters": [
              "{{#operation.response_parameters}}",
              {
                "rdfs:comment": "응답(Response) 파라미터 규격",
                "api:param_name": "{{param.name}}",
                "api:name_ko": "{{param.name_ko}}",
                "api:path": "{{param.path}}",
                "api:data_type": "{{param.data_type}}",
                "api:required": "{{param.required}}",
                "api:sample_value": "{{param.sample_value}}",
                "api:description": "{{param.description}}"
              },
              "{{/operation.response_parameters}}"
            ],
            "api:sample_messages": {
              "rdfs:comment": "실제 호출 시 반환되는 응답 메시지 예시",
              "api:xml_sample": "{{operation.sample_xml}}",
              "api:json_sample": "{{operation.sample_json}}"
            }
          },
          "{{/structure.api_operations}}"
        ],
        "api:error_codes": [
          "{{#structure.api_error_codes}}",
          {
            "rdfs:comment": "API 호출 오류 코드 및 HTTP 상태코드 정의",
            "api:code": "{{error.code}}",
            "api:message": "{{error.message}}",
            "api:http_status": "{{error.http_status}}",
            "api:description": "{{error.description}}"
          },
          "{{/structure.api_error_codes}}"
        ],
        "api:specification_url": "{{structure.api_specification_url}}",
        "api:version": "{{structure.api_version}}",
        "api:rate_limit": {
          "@value": "{{structure.api_rate_limit}}",
          "@type": "@json"
        },
        "api:authentication_description": "{{structure.api_auth_type_desc}}",
        "api:pagination": {
          "@value": "{{structure.api_pagination}}",
          "@type": "@json"
        },
        "api:payload_path": "{{structure.api_payload_path}}",
        "api:path_syntax": "{{structure.api_path_syntax}}",
        "api:namespaces": {
          "@value": "{{structure.namespaces}}",
          "@type": "@json"
        }
      },
      "wasGeneratedBy": {
        "@type": "prov:Activity",
        "prov:startedAtTime": "{{document.generated_utc}}",
        "prov:wasAssociatedWith": {
          "@type": "prov:SoftwareAgent",
          "rdfs:label": "SynthData Studio AI-Ready Engine",
          "schema:softwareVersion": "{{provenance.generator_version}}"
        }
      },
      "language": "{{dataset.language}}",
      "dct:relation": [
        "{{#dataset.relations}}",
        "{{relation}}",
        "{{/dataset.relations}}"
      ],
      "schema:about": {
        "@type": "schema:Thing",
        "schema:name": "{{dataset.theme_label}}"
      },
      "ai:purpose": "{{dataset.purpose}}",
      "hasQualityMeasurement": [
        {
          "@type": "dqv:QualityMeasurement",
          "dqv:isMeasurementOf": {
            "@id": "urn:synthetic-data:ai-ready:v2:completenessMetric"
          },
          "dqv:value": "{{quality.completeness.score}}",
          "rdfs:comment": "{{quality.completeness.evidence}}",
          "dqv:computedOn": {
            "@id": "{{dataset.uri_or_id}}"
          },
          "ai:status": "{{quality.completeness.status}}",
          "ai:scope": "{{quality.completeness.scope}}",
          "ai:reason": "{{quality.completeness.reason}}"
        },
        {
          "@type": "dqv:QualityMeasurement",
          "dqv:isMeasurementOf": {
            "@id": "urn:synthetic-data:ai-ready:v2:validityMetric"
          },
          "dqv:value": "{{quality.validity.score}}",
          "rdfs:comment": "{{quality.validity.evidence}}",
          "dqv:computedOn": {
            "@id": "{{dataset.uri_or_id}}"
          },
          "ai:status": "{{quality.validity.status}}",
          "ai:scope": "{{quality.validity.scope}}",
          "ai:reason": "{{quality.validity.reason}}"
        },
        {
          "@type": "dqv:QualityMeasurement",
          "dqv:isMeasurementOf": {
            "@id": "urn:synthetic-data:ai-ready:v2:consistencyMetric"
          },
          "dqv:value": "{{quality.consistency.score}}",
          "rdfs:comment": "{{quality.consistency.evidence}}",
          "dqv:computedOn": {
            "@id": "{{dataset.uri_or_id}}"
          },
          "ai:status": "{{quality.consistency.status}}",
          "ai:scope": "{{quality.consistency.scope}}",
          "ai:reason": "{{quality.consistency.reason}}"
        },
        {
          "@type": "dqv:QualityMeasurement",
          "dqv:isMeasurementOf": {
            "@id": "urn:synthetic-data:ai-ready:v2:accuracyMetric"
          },
          "dqv:value": "{{quality.accuracy.score}}",
