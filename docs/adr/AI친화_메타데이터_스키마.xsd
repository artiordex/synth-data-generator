<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:tns="urn:synthetic-data:ai-ready:v2:" targetNamespace="urn:synthetic-data:ai-ready:v2:" elementFormDefault="qualified" version="2.3">
  <xs:annotation>
    <xs:documentation>통합 메타데이터 XML v2.3의 프로젝트 XSD 1.0. 정부 공인 스키마가 아니다. AI친화_메타데이터_템플릿.xml의 요소명·순서·속성 및 JSON의 _template 계약을 따른다. 플레이스홀더 원문이 아니라 렌더링된 XML을 검증한다. 미확정·비해당 값은 xsi:nil="true", null 속성은 생략한다. object/array 및 복합 Canonical 값은 XML 이스케이프된 JSON 텍스트로 보존한다. XSD는 구조·타입·상태·ID 참조를 검사한다. JSON 텍스트 구문, value/valueType 일치, bindingPath 실제 값 대응, 모든 바인딩의 검토 레코드 존재, docType/dataCategory 대응, reviewRequired의 정확한 파생 및 문서 검토 요약은 Canonical/렌더러 단계에서 별도 검증해야 한다.</xs:documentation>
  </xs:annotation>
  <xs:simpleType name="NonEmptyString">
    <xs:restriction base="xs:token">
      <xs:minLength value="1" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="StatusType">
    <xs:restriction base="xs:token">
      <xs:enumeration value="AUTO_CONFIRMED" />
      <xs:enumeration value="AUTO_INFERRED" />
      <xs:enumeration value="USER_CONFIRMED" />
      <xs:enumeration value="REVIEW_REQUIRED" />
      <xs:enumeration value="NOT_APPLICABLE" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="RequiredReviewStatusType">
    <xs:restriction base="xs:token">
      <xs:enumeration value="REVIEW_REQUIRED" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="DocumentReviewStatusType">
    <xs:restriction base="xs:token">
      <xs:enumeration value="INCOMPLETE_REVIEW" />
      <xs:enumeration value="INFERRED_DRAFT" />
      <xs:enumeration value="COMPLETE_REVIEW" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="DataCategoryType">
    <xs:restriction base="xs:token">
      <xs:enumeration value="file" />
      <xs:enumeration value="api" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="DocType">
    <xs:restriction base="xs:token">
      <xs:enumeration value="file_dataset" />
      <xs:enumeration value="api_dataset" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ScopeType">
    <xs:restriction base="xs:token">
      <xs:enumeration value="FULL" />
      <xs:enumeration value="SAMPLE" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ValueType">
    <xs:restriction base="xs:token">
      <xs:enumeration value="string" />
      <xs:enumeration value="number" />
      <xs:enumeration value="integer" />
      <xs:enumeration value="boolean" />
      <xs:enumeration value="object" />
      <xs:enumeration value="array" />
      <xs:enumeration value="null" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ReferenceRoleType">
    <xs:restriction base="xs:token">
      <xs:enumeration value="PRIMARY" />
      <xs:enumeration value="SUPPLEMENTARY" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ConfidenceType">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0" />
      <xs:maxInclusive value="1" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ScoreType">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0" />
      <xs:maxInclusive value="100" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="PositiveDecimal">
    <xs:restriction base="xs:decimal">
      <xs:minExclusive value="0" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="NonNegativeDecimal">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="JsonPointerType">
    <xs:restriction base="xs:string">
      <xs:pattern value="(/([^~/]|~[01])*)+" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Sha256Type">
    <xs:restriction base="xs:token">
      <xs:pattern value="[0-9a-fA-F]{64}" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="aiReadyDataset">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="document" type="tns:DocumentType" />
