        <xs:element name="responsibleAi" minOccurs="0" type="tns:ResponsibleAiType" />
        <xs:element name="structure" type="tns:StructureType" />
        <xs:element name="fields" type="tns:FieldsType" />
        <xs:element name="quality" type="tns:QualityType" />
        <xs:element name="usage" type="tns:UsageType" />
        <xs:element name="ai" minOccurs="0" type="tns:AiType" />
        <xs:element name="governance" type="tns:GovernanceType" />
        <xs:element name="artifacts" minOccurs="0" type="tns:ArtifactsType" />
        <xs:element name="reviewRequired" type="tns:ReviewRequiredType" />
