        <xs:element name="statistics" minOccurs="0" type="tns:StatisticsType" />
        <xs:element name="lineage" minOccurs="0" type="tns:LineageType" />
        <xs:element name="interoperability" minOccurs="0" type="tns:InteroperabilityType" />
        <xs:element name="fair" minOccurs="0" type="tns:FairType" />
        <xs:element name="analysis" type="tns:AnalysisType" />
        <xs:element name="canonicalItems" type="tns:CanonicalItemsType" />
        <xs:element name="references" minOccurs="0" type="tns:ReferencesType" />
      </xs:sequence>
      <xs:attribute name="schemaVersion" type="xs:string" use="required" fixed="2.0" />
      <xs:attribute name="templateVersion" type="xs:string" use="required" fixed="2.3" />
    </xs:complexType>
    <xs:key name="canonicalId">
      <xs:selector xpath="tns:canonicalItems/tns:entry" />
      <xs:field xpath="tns:id" />
    </xs:key>
    <xs:key name="canonicalBindingPath">
      <xs:selector xpath="tns:canonicalItems/tns:entry" />
      <xs:field xpath="tns:bindingPath" />
    </xs:key>
    <xs:unique name="reviewItemId">
      <xs:selector xpath="tns:reviewRequired/tns:item" />
      <xs:field xpath="@id" />
    </xs:unique>
    <xs:keyref name="reviewCanonicalId" refer="tns:canonicalId">
      <xs:selector xpath="tns:reviewRequired/tns:item" />
      <xs:field xpath="@id" />
    </xs:keyref>
  </xs:element>
